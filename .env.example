# GEMINI_API_KEY: Required for Gemini AI API calls (Intent Extraction, Dossier Synthesis & Indic TTS fallback).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SARVAM_API_KEY: Optional Sarvam AI API Key for native Indic STT/TTS & sarvam-105b-conversations.
# Configure via Settings > Secrets panel in AI Studio.
SARVAM_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
